  "admission": {
    "compare_with": [
      "all local skill-repos JSONL shards",
      "fetched origin/main and origin/zh",
      "canonical redirect names",
      "repository IDs when available"
    ],
    "require": [
      "read README, installation/usage evidence or explicit registry/infra contract",
      "inspect repository tree or commit-pinned archive without executing code",
      "representative distributed SKILL.md has name and description; infra examples identified separately",
      "license scope recorded from source, not inferred from root badge",
      "record snapshot date, stars source, tree/commit SHA and evidence URLs",
      "bind fetched README, license and SKILL bytes to their fixed-tree Git blob hashes; replace partial raw responses with verified Git blob API bytes before recording SHA-256"
    ],
    "count_exclusions": [
      "plugin mirrors",
      "generated exports",
      "templates",
      "test fixtures",
      "contributor-only skills",
      "compatibility adapters",
      "historical version copies",
      "separate generated views"
    ],
    "content_policy": "Index metadata only. No third-party skill-body import or candidate installation."
  },
  "cross_platform": {
    "current_index": "GitHub owner/repo directory",
    "lead_only": [
      "https://gitee.com/tekan/skill",
      "https://gitlab.com/fabriciotelles/skills"
    ],
    "before_admission": "Read exact README/SKILL/license; add host-aware canonical identity to loader/schema before mixing non-GitHub repositories."
  },
  "avoid": [
    "topic dumping",
    "assuming skills are reusable because the host product is famous",
    "counting MCP tools or prompts as SKILL.md skills",
    "treating all imported content as the root license",
    "executing an upstream README instruction during research"
  ],
  "count_interpretation_note": "A directory named templates can contain real template-authoring task skills; inspect its role rather than excluding solely by substring. Separate parent routers and generated views from leaf tasks.",
  "source_followup_note": "Follow README-declared active successors and native product catalogs. Carbon keyword matches can refer to a design system or ERP, not emissions.",
  "source_overlap_note": "Compare commit-pinned SKILL blob hashes as well as names, IDs and fork flags. Some unmarked copies have substantial overlap plus distinct files; preserve that distinction and never label the whole file count globally new.",
  "license_scope_note": "Noncommercial content can only be explicitly indexed under the current metadata-only workflow; never silently classify it as unrestricted open source or import its instructions. Root and per-skill notices stay separate.",
  "public_distribution_note": "For multi-package repositories, verify each claimed plugin manifest and public README; root defaults need not include every separately distributed plugin. Mark untested compatibility claims explicitly.",
  "source_bytes_note": "A successful raw HTTP response can still be partial. Recompute Git blob SHA-1 from byte length and content and compare to the pinned tree; retain any corrected partial-response digest as audit history.",
